<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LAB6_IOT_20223291">

        <!-- Pantalla 1: inicio de sesion (FirebaseUI con layout propio) -->
        <activity
            android:name=".LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pantalla 2: lista de sesiones de estudio -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- Pantalla 3: agregar / editar sesion -->
        <activity
            android:name=".SesionFormActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Pantalla 4: graficos -->
        <activity
            android:name=".GraficosActivity"
            android:exported="false" />
    </application>

</manifest>
